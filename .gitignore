# Ignore editor-specific files.
/.vscode/
/.gemini/
/**/.serena/
/**/.vscode/

# Node.js dependencies (lefthook at root)
/node_modules/
/package-lock.json

# Environment files
.env
.env.*
!.env.example

# Test results
**/test-results/

# Logs
*.log

# Temp
/tmp/

# Blog drafts and temporary reference materials
/docs/blog/*
# WRITING_RULES.md is a living rules doc (not a draft) — keep it tracked.
# NOTE: do not simplify the two lines above back to a single `/docs/blog/` rule;
# git prunes recursion into directory-excluded paths, which silently disables
# the negation below.
!/docs/blog/WRITING_RULES.md
/docs/tmp/

# Coverage
coverage/