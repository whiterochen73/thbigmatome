# Development Dockerfile for thbigmatome-front (Vue.js)
# Node.js 22 with Vite hot-reload support
FROM node:22-alpine

WORKDIR /app

# Yarn Berry は corepack 経由（package.json の packageManager で版を固定）
RUN corepack enable

# Install dependencies (cached layer)
# .yarnrc.yml（enableScripts: false / npmMinimalAgeGate）は install より前に COPY する。
# 届かないと docker build の中で lifecycle script が走る。
COPY package.json yarn.lock .yarnrc.yml ./
RUN yarn install --immutable

# Copy application code (bind mount in development)
COPY . .

EXPOSE 5173

CMD ["yarn", "dev", "--", "--host", "0.0.0.0"]
