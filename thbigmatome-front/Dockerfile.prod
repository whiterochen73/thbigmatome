# Production Dockerfile for thbigmatome-front (Vue.js)
# Builds static files with Vite, then serves via Nginx

# ---- Build Stage ----
FROM node:20-alpine AS build

WORKDIR /app

# VITE_API_BASE_URL はビルド時に埋め込まれる（ARGで受け取る）
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Yarn Berry は corepack 経由（package.json の packageManager で版を固定）
RUN corepack enable

# .yarnrc.yml（enableScripts: false / npmMinimalAgeGate）は install より前に COPY する。
# 届かないと docker build の中で lifecycle script が走る。
COPY package.json yarn.lock .yarnrc.yml ./
RUN yarn install --immutable

COPY . .
RUN yarn build

# ---- Serve Stage ----
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
